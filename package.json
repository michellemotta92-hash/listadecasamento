{
  "name": "parasempre",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node server-dist/index.js",
    "start:production": "node server-dist/migrate.js && node server-dist/index.js",
    "migrate": "tsx server/migrate.ts",
    "migrate:production": "node server-dist/migrate.js",
    "seed": "tsx server/seed-gifts.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.100.13",
    "@vitejs/plugin-react": "5.2.0",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "express": "5.2.1",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^1.4.5-lts.2",
    "pg": "^8.16.0",
    "postcss": "8.5.20",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.76.0",
    "react-router": "7.18.1",
    "read-excel-file": "9.3.3",
    "tailwind-merge": "^3.5.0",
    "tsx": "4.23.1",
    "vite": "7.3.6",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.0.0",
    "concurrently": "9.2.4",
    "supabase": "2.109.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vitest": "^4.1.7"
  }
}
